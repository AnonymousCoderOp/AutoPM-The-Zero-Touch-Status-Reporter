# AutoPM Configuration
PORT=8000

# AI Provider Selection: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI Configuration (Leave empty to use deterministic Demo Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Force Demo Mode (Set to true to skip LLM calls and always use offline high-fidelity demo data)
FORCE_DEMO_MODE=false
